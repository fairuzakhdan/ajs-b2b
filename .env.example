# ──────────────────────────────────────────────────────────────
# Contoh environment variables untuk AJS B2B Fish Portal.
# Salin file ini menjadi `.env` lalu isi dengan nilai sebenarnya.
#   cp .env.example .env
# JANGAN commit `.env` yang berisi nilai asli.
# ──────────────────────────────────────────────────────────────

# --- Database ---
# Lokal (SQLite file-based): cukup pakai nilai di bawah ini.
DATABASE_URL="file:./prisma/dev.db"

# Produksi (Turso / libSQL): ganti DATABASE_URL dengan URL Turso,
# dan isi DATABASE_AUTH_TOKEN. Contoh:
#   DATABASE_URL="libsql://<nama-db>-<org>.turso.io"
#   DATABASE_AUTH_TOKEN="<token-dari-turso>"
# Untuk lokal (SQLite file), DATABASE_AUTH_TOKEN boleh dikosongkan.
DATABASE_AUTH_TOKEN=""

# --- Auth / Session ---
# Secret untuk menandatangani JWT session cookie.
# Generate nilai acak baru untuk setiap environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-random-secret-yang-aman"
